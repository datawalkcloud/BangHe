-- ============================================================================
-- 0020_warehouse_opening.sql —— 仓房期初库存（03 §9.9；界面见 05 §4「仓房与货位」）
--
-- 站长建仓房时手里通常已经有数：这间库房上季末还压着 1200 吨玉米（保管账上的实存）。
-- 没有「期初」这一格，此后所有库存口径都从建账那天起算，仓房页的「在储 / 剩余容量」
-- 永远是虚的，制单选去向时也看不出哪间真装得下。
--
-- 口径（与界面文案同一句，改这里必改 03 §9.9 与 05 §4）：
--   在储 ＝ 期初 ＋ 该仓房有效磅单的累计入库（结算重量）
--   剩余容量 ＝ 核定容量 − 在储（核定容量没填则为空，不替它猜一个）
-- 有效磅单复用报表那一条判据（reports.rs `STAT_WHERE`）：settlement_weight_01kg 非空
-- 且 status 不为 voided/rejected。红冲单与被冲的原单都算进来，靠负数结算重量自然互抵，
-- 不再另立一套「是否已被冲销」的判断——两套口径迟早会吵架。
-- 聚合放在读路径（masters.rs list_warehouses），不额外建视图：视图要为它单独同步
-- 03 §9.24 与快照核对，而这一份数据只有仓房页与制单下拉两个消费方，都走同一个 DTO。
--
-- 首版仍然没有出库这条腿：M11 库存与仓储（stock_movement 表已设计、首版不写入）之前，
-- 在储只增不减，卖粮/倒仓/损耗不从这里扣。这是已知边界，不是算错——所以界面上写明
-- 「含期初 · 累计入库」，且超出核定容量一律只警示不拦单（与 0912 皮重容差同规：
-- 站长没要求的闸门一个都不加）。
--
-- 只加一列，不动存量数据：已有仓房一律 NULL（它们从没申报过期初），不回填成 0——
-- 0 是一句「空仓起账」的明确表态，把没填演成填了是造出来的假数。
-- 单位取 0.1kg（全站重量单源，与 format.ts 的 `_01kg` 约定一致），不跟 capacity_ton
-- 那样用吨：期初要与磅单净重相加，混单位加一次就永久错下去；吨只在录入/展示边界换算。
-- ============================================================================

ALTER TABLE warehouse ADD COLUMN opening_weight_01kg INTEGER;
