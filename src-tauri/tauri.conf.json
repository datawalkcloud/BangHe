{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "邦禾粮站收粮系统",
  "mainBinaryName": "banghe",
  "version": "0.1.0",
  "identifier": "cn.datawalk.bh",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "邦禾粮站收粮系统",
        "width": 1440,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 760,
        "resizable": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "邦禾",
    "copyright": "© 邦禾",
    "category": "Business",
    "shortDescription": "粮站收粮过磅管理系统",
    "longDescription": "单机版粮站收粮过磅：制单、称重、化验、计价结算、付款、台账报表与小票打印，全部离线可用。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "wix": {
        "language": ["zh-CN"]
      },
      "nsis": {
        "template": null,
        "headerImage": null,
        "sidebarImage": null,
        "installerIcon": "icons/icon.ico",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  }
}
