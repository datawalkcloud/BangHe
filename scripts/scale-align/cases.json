{
  "_about": "分度取整（整量化）的唯一用例表。Rust `scale.rs::Align::apply` 与 TS `lib/scale-align.ts::applyAlign` 各自跑一遍这一份，改一边就红。",
  "_why_shared": "两边各写一遍公式，迟早有一边在 5650 / 负值 / 奇数分度上差一格；而这一格直接决定 `weigh_record.aligned_weight_01kg` 存的是什么。用例放仓库里、不放任何一边的源码里，才叫对拍而不是各自自证。",
  "_units": "raw / division / expected 全部以 0.1 kg 为单位（与 `weight_01kg` 同口径）：division=100 即 10 kg。",
  "_modes": "nearest_div（认不出的 mode 也走它）| floor_div | ceil_div | none。division<=0 一律原样。",
  "cases": [
    { "raw": 5640, "division": 100, "mode": "nearest_div", "expected": 5600, "why": "564.0 kg → 就近 10 kg 分度：560.0" },
    { "raw": 5650, "division": 100, "mode": "nearest_div", "expected": 5700, "why": "正中间那格按远离零进位，与仪表显示一致" },
    { "raw": 5649, "division": 100, "mode": "nearest_div", "expected": 5600, "why": "差 0.1 kg 就不进位" },
    { "raw": 5751, "division": 100, "mode": "nearest_div", "expected": 5800 },
    { "raw": 2360, "division": 100, "mode": "nearest_div", "expected": 2400 },
    { "raw": 0, "division": 100, "mode": "nearest_div", "expected": 0 },
    { "raw": 49, "division": 100, "mode": "nearest_div", "expected": 0, "why": "不到半格归零" },
    { "raw": 50, "division": 100, "mode": "nearest_div", "expected": 100, "why": "半格进位" },
    { "raw": -5640, "division": 100, "mode": "nearest_div", "expected": -5600, "why": "负读数=比参考皮轻，取整方向要对称" },
    { "raw": -5650, "division": 100, "mode": "nearest_div", "expected": -5700, "why": "远离零，不是朝零" },
    { "raw": 3200000, "division": 100, "mode": "nearest_div", "expected": 3200000, "why": "320 t 满载，整除不动" },
    { "raw": 5640, "division": 20, "mode": "nearest_div", "expected": 5640, "why": "2 kg 分度：本来就是整数倍" },
    { "raw": 5645, "division": 20, "mode": "nearest_div", "expected": 5640 },
    { "raw": 5650, "division": 20, "mode": "nearest_div", "expected": 5660, "why": "半格 = 10，进位后是 5660 不是 5650" },
    { "raw": 5640, "division": 25, "mode": "nearest_div", "expected": 5650, "why": "奇数分度：d/2 先整数截半（12），这条最容易两边写不一样" },
    { "raw": 12, "division": 25, "mode": "nearest_div", "expected": 0 },
    { "raw": 13, "division": 25, "mode": "nearest_div", "expected": 25 },
    { "raw": 5643, "division": 1, "mode": "nearest_div", "expected": 5643, "why": "分度 0.1 kg = 仪表最小位，等于不取整" },
    { "raw": 5643, "division": 0, "mode": "nearest_div", "expected": 5643, "why": "division<=0 → 原样（台账里没有启用的磅就落在这里）" },
    { "raw": 5643, "division": 100, "mode": "none", "expected": 5643, "why": "显式关掉取整" },
    { "raw": 5643, "division": 100, "mode": "", "expected": 5643, "why": "空串与 none 同档（Rust match 里同一条臂）" },
    { "raw": 5690, "division": 100, "mode": "floor_div", "expected": 5600 },
    { "raw": 5600, "division": 100, "mode": "floor_div", "expected": 5600, "why": "整除时 floor 不再多扣一格" },
    { "raw": -5610, "division": 100, "mode": "floor_div", "expected": -5700, "why": "div_euclid 是地板除：负值朝 -∞" },
    { "raw": 5610, "division": 100, "mode": "ceil_div", "expected": 5700 },
    { "raw": -5690, "division": 100, "mode": "ceil_div", "expected": -5600, "why": "负值朝 +∞" },
    { "raw": -5600, "division": 100, "mode": "ceil_div", "expected": -5600 },
    { "raw": 5640, "division": 1000, "mode": "nearest_div", "expected": 6000, "why": "100 kg 分度的老式机械衡" },
    { "raw": 5400, "division": 1000, "mode": "nearest_div", "expected": 5000 },
    { "raw": 5500, "division": 1000, "mode": "nearest_div", "expected": 6000 },
    { "raw": 5640, "division": 100, "mode": "half_up", "expected": 5600, "why": "认不出的 mode 落进 nearest 那条臂——0032 退役掉的旧站点参数值域正是这一族，钉住它不会另算一套" },
    { "raw": 5650, "division": 100, "mode": "floor", "expected": 5700, "why": "同上：`floor` 不是 `floor_div`，按就近走。这是已知行为，不是笔误，别顺手'修'成静默兜底" }
  ]
}
